<html xmlns:o="urn:schemas-microsoft-com:office:office"
xmlns:x="urn:schemas-microsoft-com:office:excel"
xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<style>
    th { background-color: #001A29; color: #ffffff; font-weight: bold; font-size: 14px; height: 35px; text-align: center; }
    td { font-size: 13px; height: 30px; vertical-align: middle; border: 1px solid #dcdcdc; padding-left: 5px; }
    .level-1 { background-color: #e6f2ff; font-weight: bold; color: #004085; }
    .level-2 { background-color: #fff3cd; font-weight: bold; color: #856404; }
    .level-3 { background-color: #f8f9fa; color: #333333; }
    .input-cell { background-color: #ffffff; }
    .footer-header { background-color: #2c3e50; font-weight: bold; color: #ffffff; }
</style>
</head>
<body>
<table border="1" style="border-collapse: collapse; font-family: Arial, sans-serif; width: 1000px;">
    <tr>
        <th style="width: 200px;">Ana Menü</th>
        <th style="width: 250px;">Alt Menü</th>
        <th style="width: 250px;">Alt-Alt Menü (Sayfalar)</th>
        <th style="width: 300px; background-color: #FF5D05;">Yeni İsim Önerisi (Burayı Değiştirin)</th>
        <th style="width: 400px; background-color: #FF5D05;">Sayfa İçeriği / Notlarınız</th>
    </tr>

    <!-- YETENEKLER İÇİN -->
    <tr><td class="level-1">Yetenekler İçin</td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td></tr>
    
    <tr><td class="input-cell"></td><td class="level-2">Almanya'da Çalışmak</td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Doktorluk</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Hemşirelik</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Fizyoterapist</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Ergoterapist</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Yaşlı Bakım</td><td class="input-cell"></td><td class="input-cell"></td></tr>

    <tr><td class="input-cell"></td><td class="level-2">Hizmetler ve Bilgiler</td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Denklik Başvurusu (Bescheid)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">İşveren Bulma & Mülakat</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Vize & Relokasyon (Home)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Onboarding ve Uyum</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Oryantasyon</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Resmi Daire İşlemleri</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Havalimanı Karşılama</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Konaklama</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Denklik Tamamlama</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Çocuk Okul Ayarlanması</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Teşvik Başvurusu</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Dil Sınavına Yönlendirme</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Urkunde Alınması</td><td class="input-cell"></td><td class="input-cell"></td></tr>

    <!-- İŞVERENLER İÇİN -->
    <tr><td class="level-1">İşverenler İçin</td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td></tr>

    <tr><td class="input-cell"></td><td class="level-2">Profesyoneller İçin Bilgiler</td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Hemşireler</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Fizyoterapist</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Ergoterapistler</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Sağlık Meslekleri</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Doktorlar ve Diş Hekimleri</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Mühendisler ve Teknik Meslekler</td><td class="input-cell"></td><td class="input-cell"></td></tr>

    <tr><td class="input-cell"></td><td class="level-2">Hizmetlerimiz</td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Her Şey Dahil Hizmet</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Seçilmiş Hizmetler</td><td class="input-cell"></td><td class="input-cell"></td></tr>

    <!-- OTHER TOP MENUS -->
    <tr><td class="level-1">Hakkımızda</td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="level-1">Açık İlanlar</td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="level-1">İletişim</td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td></tr>

    <!-- HEADER & UTILITY MENUS -->
    <tr><td colspan="5" style="height: 15px; background: #ffffff; border: none;"></td></tr>
    <tr><td class="footer-header" colspan="3">Üst Menü / Dil ve Butonlar (Header / Top-Bar)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="level-2">Şimdi Başvur (Buton)</td><td class="input-cell"></td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="level-2">Dil Seçenekleri</td><td class="level-3">Türkçe (TR)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Deutsch (DE)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">English (EN)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Français (FR)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">العربية (AR)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    
    <!-- TEST / WIZARD MENU -->
    <tr><td colspan="5" style="height: 15px; background: #ffffff; border: none;"></td></tr>
    <tr><td class="footer-header" colspan="3">Test ve Form Modülleri</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="level-2">Almanya Kariyer & Uygunluk Testi</td><td class="level-3">Uygunluk Testini Başlat (Buton)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3" style="font-weight:bold; background-color: #e2e3e5;">Soru 1: Almanya'da İcra Etmek İstediğiniz Meslek Hangisidir?</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- Doktor / Hekim</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- Hemşire & Sağlık Çalışanı</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- MTR / Radyoloji / Fizyoterapist</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- Mühendislik & BT / IT</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3" style="font-weight:bold; background-color: #e2e3e5;">Soru 2: Mevcut Almanca Dil Seviyeniz Nedir?</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- Almancam Yok / Başlangıç</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- A1 - A2 Seviyesi</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- B1 - B2 Seviyesi</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- C1 / FSP Tıp Seviyesi</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3" style="font-weight:bold; background-color: #e2e3e5;">Soru 3: Sirius Global'den Öncelikli Beklentiniz Nedir?</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- Tam Paket (Dil + Denklik + İş)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- Sirius Akademi Dil Kursu</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- İş Bulma & Klinik Eşleştirme</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">&nbsp;&nbsp;- Sirius Home Relokasyon</td><td class="input-cell"></td><td class="input-cell"></td></tr>

    <!-- FOOTER MENUS -->
    <tr><td colspan="5" style="height: 15px; background: #ffffff; border: none;"></td></tr>
    <tr><td class="footer-header" colspan="3">Alt Menü (Footer) Öğeleri</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="level-2">Bağlantılar</td><td class="level-3">Sirius Medicare</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Sirius Home Relokasyon</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Sirius Talent & Partner</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="level-2">Mevzuat & Yasal (EU/DE)</td><td class="level-3">Hakkımızda</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Legal Notice</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Künye (Impressum § 5 DDG)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Gizlilik Politikası (DSGVO)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Şartlar & Koşullar (AGB)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    <tr><td class="input-cell"></td><td class="input-cell"></td><td class="level-3">Çerez Tercihleri (Cookies)</td><td class="input-cell"></td><td class="input-cell"></td></tr>
    
</table>
</body>
</html>
